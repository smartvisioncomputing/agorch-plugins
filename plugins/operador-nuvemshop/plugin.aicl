plugin "operador-nuvemshop" {
  aicl_version  = "1.1"
  namespace     = "ao"
  version       = "0.1.1"
  publisher     = "publisher:ao"
  description   = "Operador de loja Nuvemshop: resumo diário de pedidos, alerta de estoque baixo, preço e cupom com aprovação."
  license       = "Apache-2.0"
  release_notes = "Pins the connector releases with English tool names and descriptions. The skill, scenarios and agents are unchanged."
  stack         = "./stack"

  exports {
    agents = ["operador"]
    tools  = ["calcular"]
    skills = ["operacao"]
  }

  requires "nuvemshop" {
    package = "ao/nuvemshop-mcp"
    version = "^0.1.0"
    tools   = ["list_orders", "list_products", "update_product", "create_coupon"]
    reason  = "Ler pedidos e estoque, e, com aprovação, mudar preço e criar cupom"
  }

  requires "slack" {
    package = "ao/slack-mcp"
    version = "^0.1.0"
    tools   = ["slack_search_channels", "slack_send_message"]
    reason  = "Postar o resumo do dia e o alerta de estoque no canal da loja"
  }

  permissions {
    side_effects = ["read_only", "mutating"]
    data_sent    = ["order_filters", "product_price", "coupon_rules", "slack_message_text"]
  }
}
