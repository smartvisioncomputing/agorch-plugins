plugin "nuvemshop" {
  aicl_version  = "1.1"
  namespace     = "ao"
  version       = "0.1.3"
  publisher     = "publisher:ao"
  description   = "Nuvemshop MCP (official): store orders, products, prices and coupons."
  license       = "Apache-2.0"
  stack         = "./stack"
  readme        = "./README.md"
  release_notes = "Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged."
  scope_labels = {
    "read_orders"    = "Read your store's orders"
    "read_products"  = "Read your products and stock"
    "write_products" = "Change product prices and stock"
    "write_coupons"  = "Create discount coupons"
  }
  source {
    repository = "https://github.com/smartvisioncomputing/agorch-plugins"
  }

  exports {
    tools = ["list_orders", "list_products", "update_product", "create_coupon"]
  }

  permissions {
    authorities  = ["nuvemshop_mcp"]
    side_effects = ["read_only", "mutating"]
    data_sent    = ["order_filters", "product_price", "product_stock", "coupon_rules"]
  }
}
