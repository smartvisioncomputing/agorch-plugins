plugin "sentry" {
  aicl_version  = "1.1"
  namespace     = "ao"
  version       = "0.1.3"
  publisher     = "publisher:ao"
  description   = "Sentry MCP (official): search error issues and read details, stack traces and releases."
  license       = "Apache-2.0"
  stack         = "./stack"
  readme        = "./README.md"
  release_notes = "Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged."
  scope_labels = {
    "org:read"     = "Read your Sentry organization"
    "project:read" = "Read your projects and their releases"
    "event:read"   = "Read issues, events and stack traces"
  }
  source {
    repository = "https://github.com/smartvisioncomputing/agorch-plugins"
  }

  exports {
    tools = ["sentry_search_issues", "get_sentry_resource"]
  }

  permissions {
    authorities  = ["sentry_mcp"]
    side_effects = ["read_only"]
    data_sent    = ["sentry_query", "sentry_issue_id"]
  }
}
