plugin "github" {
  aicl_version  = "1.1"
  namespace     = "ao"
  version       = "0.1.3"
  publisher     = "publisher:ao"
  description   = "GitHub MCP (official): search and open issues, read files and commits from a repository."
  license       = "Apache-2.0"
  stack         = "./stack"
  readme        = "./README.md"
  release_notes = "Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged."
  scope_labels = {
    "repo" = "Read and write issues and read code in your repositories"
  }
  source {
    repository = "https://github.com/smartvisioncomputing/agorch-plugins"
  }

  exports {
    tools = ["github_search_issues", "get_file_contents", "list_commits", "issue_write"]
  }

  permissions {
    authorities  = ["github_mcp"]
    side_effects = ["read_only", "mutating"]
    data_sent    = ["repository_name", "issue_title", "issue_body", "file_path"]
    secrets      = ["github_client_id", "github_client_secret"]
  }
}
