# Official Notion MCP server. Checked on 2026-10-01:
#   doc:    https://developers.notion.com/guides/mcp/mcp-supported-tools
#   OAuth:  https://mcp.notion.com/.well-known/oauth-authorization-server
#           (authorize, token, register: DCR; a single scope, "default")
# No starter uses Notion yet: the allowlist is the minimum to read.
stack "notion" {
  aicl_version = "1.1"
  version      = "0.1.3"
}

authority "notion_mcp" {
  origins  = ["https://mcp.notion.com"]
  purposes = ["mcp_server", "oauth_authorization", "oauth_token", "oauth_registration"]
}

# The server supports dynamic client registration, but a sealed package
# (ComponentPackage v1.1) does not carry a dynamic client, so it declares
# pre_registered + ao_managed: Agorch registers one client with the vendor and
# uses it for every organization that connects.
auth_provider "notion_oauth" {
  authorities = ["notion_mcp"]
  principal   = "organization" # one connection per Agorch organization
  oauth2_authorization_code_pkce {
    registration            = "pre_registered"
    client_mode             = "ao_managed"
    authorization_authority = "notion_mcp"
    authorization_path      = "/authorize"
    token_authority         = "notion_mcp"
    token_path              = "/token"
    issuer                  = "https://mcp.notion.com" # RFC 8414, exactly as the authorization server publishes it
    scopes                  = ["default"]              # Notion has no granular scopes
    redirect_uris           = ["https://app.agorch.ai/connection-oauth/callback"]
  }
}

mcp_server "notion_mcp" {
  authority = "notion_mcp"
  url       = "https://mcp.notion.com/mcp"
  auth      = "notion_oauth"
  allow     = ["notion-search", "notion-fetch"]
}

tool "notion_search" {
  name        = "Search Notion"
  side_effect = "read_only"
  timeout_ms  = 30000
  mcp {
    server = "notion_mcp"
    tool   = "notion-search"
  }
}

tool "notion_fetch" {
  name        = "Read Notion page or database"
  side_effect = "read_only"
  timeout_ms  = 30000
  mcp {
    server = "notion_mcp"
    tool   = "notion-fetch"
  }
}
