plugin "hubspot" {
  aicl_version  = "1.1"
  namespace     = "ao"
  version       = "0.1.4"
  publisher     = "publisher:ao"
  description   = "HubSpot MCP (official): search, read and write CRM records and find the owning sales rep."
  license       = "Apache-2.0"
  stack         = "./stack"
  readme        = "./README.md"
  release_notes = "Signs the token endpoint client authentication as client_secret_post, the only method the HubSpot MCP authorization server publishes: the client id and secret go in the token request body instead of an HTTP Basic header, for the code exchange and every refresh. Tools, permissions, scopes and endpoints are unchanged."
  source {
    repository = "https://github.com/smartvisioncomputing/agorch-plugins"
  }

  exports {
    tools = ["search_crm_objects", "get_crm_objects", "manage_crm_objects", "search_owners"]
  }

  permissions {
    authorities  = ["hubspot_mcp"]
    side_effects = ["read_only", "mutating"]
    data_sent    = ["crm_search_filters", "crm_record_fields", "crm_note_text"]
    secrets      = ["hubspot_client_id", "hubspot_client_secret"]
  }
}
