e_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"atlassian_auth","kind":"https_origin","origins":["https://auth.atlassian.com"],"purposes":["oauth_authorization","oauth_token"],"redirect_policy":"none"},{"authority_id":"atlassian_mcp","kind":"https_origin","origins":["https://mcp.atlassian.com"],"purposes":["connection_verification","mcp_server"],"redirect_policy":"none"}],"package":{"description":"Atlassian Rovo MCP (official): search, read, create, edit and comment on Jira issues.","distribution_visibility":"registry","entry_component":{"component_id":"add_or_edit_jira_issue_comment","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"add_or_edit_jira_issue_comment","kind":"tool"},"entrypoint_id":"add_or_edit_jira_issue_comment","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"create_jira_issue","kind":"tool"},"entrypoint_id":"create_jira_issue","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"edit_jira_issue","kind":"tool"},"entrypoint_id":"edit_jira_issue","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"get_accessible_atlassian_resources","kind":"tool"},"entrypoint_id":"get_accessible_atlassian_resources","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"get_jira_issue","kind":"tool"},"entrypoint_id":"get_jira_issue","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"search_jira_issues_using_jql","kind":"tool"},"entrypoint_id":"search_jira_issues_using_jql","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"atlassian / atlassian_mcp","namespace":"ao","owner":"publisher:ao","package_id":"atlassian-mcp","presentation":{"license":"Apache-2.0","readme":"# Atlassian (Jira)\n\nConnect your Agorch agents to Jira through Atlassian's official Rovo MCP server (`https://mcp.atlassian.com/v2/mcp`). Agents can find your Atlassian sites, search issues with JQL, read, create and edit issues, and comment on them.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| List Atlassian sites | Lists the sites the connected account can open. | No |\n| Search issues (JQL) | Finds issues with a JQL query. | No |\n| Read an issue | Reads one issue and its fields. | No |\n| Create an issue | Opens an issue in a project: summary, type, description and project fields. | Yes |\n| Edit an issue | Changes editable fields such as priority, component and assignee. | Yes |\n| Comment on an issue | Adds or edits a comment. | Yes |\n\n## What connecting asks for\n\n- **One click and one sign-in.** Agorch already has an Atlassian app, so there is nothing to create. Click Connect, sign in to Atlassian and pick the site.\n- **Rovo MCP turned on for your site.** A site admin enables it in Atlassian administration. Calls made through Rovo MCP count toward your Rovo credits.\n- The connection belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `search:jira:agent-interface` | Search Jira issues with JQL |\n| `read:jira:agent-interface` | Read Jira issues and the sites you can access |\n| `write:jira:agent-interface` | Create, edit and comment on Jira issues |\n\n## Examples\n\n- \"Find the tickets created in project SUP in the last 24 hours.\"\n- \"Set SUP-142 to High priority, component Billing, and explain why in a comment.\"\n- \"Open a bug in SUP for the checkout timeout with the steps from this thread.\"\n\n## Data sent to Atlassian\n\nJQL queries, issue fields and comment text.\n\n## Good to know\n\n- Creating, editing and commenting change data. Agorch never retries them on its own, and the starters ask a person to approve each call.\n- Only the six tools above are allowed through. Tools that Rovo MCP hides by default stay blocked.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"read:jira:agent-interface":"Read Jira issues and the sites you can access","search:jira:agent-interface":"Search Jira issues with JQL","write:jira:agent-interface":"Create, edit and comment on Jira issues"},"source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/atlassian","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"b700206319a24b18c5c84c76d5276c32e25a5abb"}},"version":"0.1.4"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.4","source_kind":"aicl","source_ref":"ao/atlassian"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"add_or_edit_jira_issue_comment","kind":"tool"},{"component_id":"create_jira_issue","kind":"tool"},{"component_id":"edit_jira_issue","kind":"tool"},{"component_id":"get_accessible_atlassian_resources","kind":"tool"},{"component_id":"get_jira_issue","kind":"tool"},{"component_id":"search_jira_issues_using_jql","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"atlassian_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only","mutating"],"tier":"R1"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}