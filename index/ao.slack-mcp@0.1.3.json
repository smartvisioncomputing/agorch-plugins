s_list","method":"POST","path":"/mcp"}}},{"internal_dependencies":[{"component_id":"connection","kind":"connection_definition"}],"name":"Find Slack channel","ref":{"component_id":"slack_search_channels","kind":"tool"},"schema_ref":"aicl://component/tool/v1","source":{"revision":"0.1.3","source_kind":"aicl","source_ref":"./stack"},"spec":{"connection_requirement_ids":["slack_mcp"],"data_received":[],"data_sent":[],"execution":{"authority_ref":"slack_mcp","mcp_server":"https://mcp.slack.com/mcp","mcp_tool":"slack_search_channels","transport":"mcp_streamable_http"},"idempotency":{"kind":"naturally_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"read_only","timeout_ms":20000}},{"internal_dependencies":[{"component_id":"connection","kind":"connection_definition"}],"name":"Send Slack message","ref":{"component_id":"slack_send_message","kind":"tool"},"schema_ref":"aicl://component/tool/v1","source":{"revision":"0.1.3","source_kind":"aicl","source_ref":"./stack"},"spec":{"connection_requirement_ids":["slack_mcp"],"data_received":[],"data_sent":[],"execution":{"authority_ref":"slack_mcp","mcp_server":"https://mcp.slack.com/mcp","mcp_tool":"slack_send_message","transport":"mcp_streamable_http"},"idempotency":{"kind":"not_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"mutating","timeout_ms":20000}}],"data_handling":{"publisher_receives_runtime_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"slack_auth","kind":"https_origin","origins":["https://slack.com"],"purposes":["oauth_authorization","oauth_token"],"redirect_policy":"none"},{"authority_id":"slack_mcp","kind":"https_origin","origins":["https://mcp.slack.com"],"purposes":["connection_verification","mcp_server"],"redirect_policy":"none"}],"package":{"description":"Slack MCP (official): find a channel and post a message as the connected user.","distribution_visibility":"registry","entry_component":{"component_id":"slack_search_channels","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"slack_search_channels","kind":"tool"},"entrypoint_id":"slack_search_channels","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"slack_send_message","kind":"tool"},"entrypoint_id":"slack_send_message","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"slack / slack_mcp","namespace":"ao","owner":"publisher:ao","package_id":"slack-mcp","presentation":{"license":"Apache-2.0","readme":"# Slack\n\nConnect your Agorch agents to Slack through Slack's official MCP server (`https://mcp.slack.com/mcp`). Agents can find a channel and post a message to it, such as a daily summary or an alert.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| Find a channel | Searches the workspace's public channels by name. | No |\n| Send a message | Posts a message to a channel as the person who connected. | Yes |\n\n## What connecting asks for\n\n- **Your own Slack app.** Slack's MCP server only accepts apps that are internal to your workspace or listed in the Slack Marketplace, so your workspace creates one at `api.slack.com/apps`. Add the user scopes below and set the redirect URL to `https://app.agorch.ai/connection-oauth/callback`.\n- **The app's client ID and client secret,** entered once in the Agorch connection. Agorch stores them; they never appear in a package or in this repository.\n- **One sign-in.** Slack's MCP server works with user tokens, so messages are posted as the person who connects. The connection then belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `search:read.public` | Find public channels |\n| `chat:write` | Post messages as the person who connected |\n\n## Examples\n\n- \"Post today's triage summary in #support-eng.\"\n- \"Tell #on-call that issue 412 was opened for the checkout error.\"\n\n## Data sent to Slack\n\nChannel search terms and message text.\n\n## Good to know\n\n- Sending a message changes data. Agorch never retries it on its own, and the starters ask a person to approve each call.\n- Only the two tools above are allowed through.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"chat:write":"Post messages as the person who connected","search:read.public":"Find public channels"},"source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/slack","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"233170e906b0d9c275d3c70498a95b3b5a5deb0d"}},"version":"0.1.3"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.3","source_kind":"aicl","source_ref":"ao/slack"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"slack_search_channels","kind":"tool"},{"component_id":"slack_send_message","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"slack_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only","mutating"],"tier":"R1"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}