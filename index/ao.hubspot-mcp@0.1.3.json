ernal_dependencies":[{"component_id":"connection","kind":"connection_definition"}],"name":"Search sales reps (owners)","ref":{"component_id":"search_owners","kind":"tool"},"schema_ref":"aicl://component/tool/v1","source":{"revision":"0.1.3","source_kind":"aicl","source_ref":"./stack"},"spec":{"connection_requirement_ids":["hubspot_mcp"],"data_received":[],"data_sent":[],"execution":{"authority_ref":"hubspot_mcp","mcp_server":"https://mcp.hubspot.com/","mcp_tool":"search_owners","transport":"mcp_streamable_http"},"idempotency":{"kind":"naturally_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"read_only","timeout_ms":20000}}],"data_handling":{"publisher_receives_runtime_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"hubspot_mcp","kind":"https_origin","origins":["https://mcp.hubspot.com"],"purposes":["connection_verification","mcp_server","oauth_authorization","oauth_token"],"redirect_policy":"none"}],"package":{"description":"HubSpot MCP (official): search, read and write CRM records and find the owning sales rep.","distribution_visibility":"registry","entry_component":{"component_id":"get_crm_objects","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"get_crm_objects","kind":"tool"},"entrypoint_id":"get_crm_objects","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"manage_crm_objects","kind":"tool"},"entrypoint_id":"manage_crm_objects","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"search_crm_objects","kind":"tool"},"entrypoint_id":"search_crm_objects","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"search_owners","kind":"tool"},"entrypoint_id":"search_owners","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"hubspot / hubspot_mcp","namespace":"ao","owner":"publisher:ao","package_id":"hubspot-mcp","presentation":{"license":"Apache-2.0","readme":"# HubSpot\n\nConnect your Agorch agents to your HubSpot CRM through HubSpot's official remote MCP server (`https://mcp.hubspot.com/`). Agents can search and read contacts, companies and deals, record notes and tasks, and find the salesperson who owns a record.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| Search CRM records | Finds contacts, companies and deals by filters. | No |\n| Read CRM records | Reads the fields of one or more records. | No |\n| Write CRM records | Creates or updates contacts, deals, notes and tasks. | Yes |\n| Search owners | Finds the HubSpot users who own records, such as the salesperson of a lead. | No |\n\n## What connecting asks for\n\n- **Your own HubSpot MCP auth app.** HubSpot asks each customer to create one: go to `app.hubspot.com/l/mcp-auth-apps/`, create the app and set the redirect URL to `https://app.agorch.ai/connection-oauth/callback`.\n- **The app's client ID and client secret,** entered once in the Agorch connection. Agorch stores them; they never appear in a package or in this repository.\n- **One sign-in.** The person who connects authorizes HubSpot for your Agorch organization, and every agent in the organization uses that connection.\n\n### Permissions\n\nThe connector asks for no OAuth scopes. HubSpot decides what the MCP server can reach from the tools installed on the auth app, so review that list when you create it.\n\n## Examples\n\n- \"Find the contacts created today and show their company and lifecycle stage.\"\n- \"Add a note to the Acme deal saying the proposal was sent, and create a follow-up task for Friday.\"\n- \"Who owns the contact maria@example.com?\"\n\n## Data sent to HubSpot\n\nCRM search filters, record fields and note text.\n\n## Good to know\n\n- Writing CRM records changes data. Agorch never retries it on its own, and the starters ask a person to approve each call.\n- Only the four tools above are allowed through.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/hubspot","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"fcaf3831d52735d7760115d042f70a51821be0e9"}},"version":"0.1.3"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.3","source_kind":"aicl","source_ref":"ao/hubspot"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"get_crm_objects","kind":"tool"},{"component_id":"manage_crm_objects","kind":"tool"},{"component_id":"search_crm_objects","kind":"tool"},{"component_id":"search_owners","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"hubspot_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only","mutating"],"tier":"R1"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}