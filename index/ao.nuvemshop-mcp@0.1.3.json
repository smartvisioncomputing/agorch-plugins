mcp_server":"https://admin-mcp.tiendanube.com/","mcp_tool":"update_product","transport":"mcp_streamable_http"},"idempotency":{"kind":"not_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"mutating","timeout_ms":30000}}],"data_handling":{"publisher_receives_runtime_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"nuvemshop_mcp","kind":"https_origin","origins":["https://admin-mcp.tiendanube.com"],"purposes":["connection_verification","mcp_server","oauth_authorization","oauth_token"],"redirect_policy":"none"}],"package":{"description":"Nuvemshop MCP (official): store orders, products, prices and coupons.","distribution_visibility":"registry","entry_component":{"component_id":"create_coupon","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"create_coupon","kind":"tool"},"entrypoint_id":"create_coupon","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"list_orders","kind":"tool"},"entrypoint_id":"list_orders","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"list_products","kind":"tool"},"entrypoint_id":"list_products","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"update_product","kind":"tool"},"entrypoint_id":"update_product","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"nuvemshop / nuvemshop_mcp","namespace":"ao","owner":"publisher:ao","package_id":"nuvemshop-mcp","presentation":{"license":"Apache-2.0","readme":"# Nuvemshop\n\nConnect your Agorch agents to your Nuvemshop store through Nuvemshop's official admin MCP server (`https://admin-mcp.tiendanube.com/`, the host Nuvemshop's own metadata announces). Agents can read orders, products and stock, change prices and stock, and create coupons.\n\n**Beta.** Nuvemshop does not publish the names of its MCP tools. They are confirmed against the live server during the beta. If a name differs, only the mapping changes: the tools your agents use keep their names in Agorch.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| List orders | Lists the store's orders, with filters. | No |\n| List products and stock | Lists products, prices and stock levels. | No |\n| Update a product | Changes a product's price or stock. | Yes |\n| Create a coupon | Creates a discount coupon with its rules. | Yes |\n\n## What connecting asks for\n\n- **One click and one sign-in.** Agorch already has a Nuvemshop app, so there is nothing to create. Click Connect, sign in as the store owner and authorize the store.\n- The connection belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `read_orders` | Read your store's orders |\n| `read_products` | Read your products and stock |\n| `write_products` | Change product prices and stock |\n| `write_coupons` | Create discount coupons |\n\n## Examples\n\n- \"Summarize yesterday's paid orders: count, revenue and average ticket.\"\n- \"Which products have five units or fewer in stock?\"\n- \"Create a 10% coupon for the winter collection, valid until Sunday.\"\n\n## Data sent to Nuvemshop\n\nOrder filters, product prices and stock, and coupon rules.\n\n## Good to know\n\n- Updating products and creating coupons change data. Agorch never retries them on its own, and the starters ask a person to approve each call.\n- Only the four tools above are allowed through.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"read_orders":"Read your store's orders","read_products":"Read your products and stock","write_coupons":"Create discount coupons","write_products":"Change product prices and stock"},"source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/nuvemshop","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"ffe7cd878cec50e4d9b224867f332e856730dafe"}},"version":"0.1.3"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.3","source_kind":"aicl","source_ref":"ao/nuvemshop"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"create_coupon","kind":"tool"},{"component_id":"list_orders","kind":"tool"},{"component_id":"list_products","kind":"tool"},{"component_id":"update_product","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"nuvemshop_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only","mutating"],"tier":"R1"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}