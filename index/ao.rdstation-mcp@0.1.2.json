act","transport":"mcp_streamable_http"},"idempotency":{"kind":"not_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"mutating","timeout_ms":30000}}],"data_handling":{"publisher_receives_runtime_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"rdstation_mcp","kind":"https_origin","origins":["https://mcp.rdstationmentor.com"],"purposes":["connection_verification","mcp_server","oauth_authorization","oauth_token"],"redirect_policy":"none"}],"package":{"description":"RD Station MCP (official): contacts, sales funnel and tasks in RD Station CRM and Marketing.","distribution_visibility":"registry","entry_component":{"component_id":"create_task","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"create_task","kind":"tool"},"entrypoint_id":"create_task","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"move_deal_stage","kind":"tool"},"entrypoint_id":"move_deal_stage","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"search_contacts","kind":"tool"},"entrypoint_id":"search_contacts","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"update_contact","kind":"tool"},"entrypoint_id":"update_contact","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"rdstation / rdstation_mcp","namespace":"ao","owner":"publisher:ao","package_id":"rdstation-mcp","presentation":{"license":"Apache-2.0","readme":"# RD Station\n\nConnect your Agorch agents to RD Station CRM and RD Station Marketing through RD Station's official MCP server (`https://mcp.rdstationmentor.com/`). Agents can find contacts and leads, update them, move deals to another stage and create follow-up tasks.\n\n**Beta.** RD Station does not yet publish the server's OAuth details or tool names. The endpoint, scopes and tool names are confirmed with the first live connections during the beta. If a name differs, only the mapping changes: the tools your agents use keep their names in Agorch.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| Search contacts and leads | Finds contacts and recent conversions. | No |\n| Update a contact | Changes a contact's fields, such as the qualification. | Yes |\n| Move a deal | Moves a deal to another stage of the funnel. | Yes |\n| Create a follow-up task | Creates a task for the deal's owner. | Yes |\n\n## What connecting asks for\n\n- **An RD Station CRM or RD Station Marketing subscription.**\n- **One click and one sign-in.** Agorch registers the app with RD Station, so there is nothing to create. Click Connect and authorize your RD Station account.\n- The connection belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `crm` | Read and update contacts, deals and tasks in RD Station CRM |\n| `marketing` | Read leads and conversions in RD Station Marketing |\n\n## Examples\n\n- \"Show today's conversions with their source and company.\"\n- \"Move the Acme deal to Proposal and create a follow-up task for tomorrow.\"\n\n## Data sent to RD Station\n\nContact fields, deal stages and task text.\n\n## Good to know\n\n- Updating contacts, moving deals and creating tasks change data. Agorch never retries them on its own, and the starters ask a person to approve each call.\n- Only the four tools above are allowed through.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"crm":"Read and 