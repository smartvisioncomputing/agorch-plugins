x_response_bytes":262144,"permissions":[],"side_effect":"mutating","timeout_ms":30000}},{"internal_dependencies":[{"component_id":"connection","kind":"connection_definition"}],"name":"List commits","ref":{"component_id":"list_commits","kind":"tool"},"schema_ref":"aicl://component/tool/v1","source":{"revision":"0.1.3","source_kind":"aicl","source_ref":"./stack"},"spec":{"connection_requirement_ids":["github_mcp"],"data_received":[],"data_sent":[],"execution":{"authority_ref":"github_mcp","mcp_server":"https://api.githubcopilot.com/mcp/","mcp_tool":"list_commits","transport":"mcp_streamable_http"},"idempotency":{"kind":"naturally_idempotent"},"max_response_bytes":262144,"permissions":[],"side_effect":"read_only","timeout_ms":30000}}],"data_handling":{"publisher_receives_runtime_data":false,"receives":[],"sends":[]},"dependencies":{"lock":[],"lock_digest":"sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945","requirements":[],"resolver_version":"aicl-resolver/1"},"eval_suite_refs":[],"external_authorities":[{"authority_id":"github_auth","kind":"https_origin","origins":["https://github.com"],"purposes":["oauth_authorization","oauth_token"],"redirect_policy":"none"},{"authority_id":"github_mcp","kind":"https_origin","origins":["https://api.githubcopilot.com"],"purposes":["connection_verification","mcp_server"],"redirect_policy":"none"}],"package":{"description":"GitHub MCP (official): search and open issues, read files and commits from a repository.","distribution_visibility":"registry","entry_component":{"component_id":"get_file_contents","kind":"tool"},"entrypoints":[{"component_ref":{"component_id":"get_file_contents","kind":"tool"},"entrypoint_id":"get_file_contents","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"github_search_issues","kind":"tool"},"entrypoint_id":"github_search_issues","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"issue_write","kind":"tool"},"entrypoint_id":"issue_write","input_schema":{"x-ao-input-schema":"discovered"}},{"component_ref":{"component_id":"list_commits","kind":"tool"},"entrypoint_id":"list_commits","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"github / github_mcp","namespace":"ao","owner":"publisher:ao","package_id":"github-mcp","presentation":{"license":"Apache-2.0","readme":"# GitHub\n\nConnect your Agorch agents to GitHub through GitHub's official remote MCP server (`https://api.githubcopilot.com/mcp/`). Agents can search issues, read files such as `CODEOWNERS`, list commits, and open or update issues.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| Search issues | Finds issues with GitHub's search syntax. | No |\n| Read a file | Reads a file from a repository, for example `CODEOWNERS`. | No |\n| List commits | Lists the recent commits of a repository. | No |\n| Open or update an issue | Creates an issue or updates an existing one. It never deletes. | Yes |\n\n## What connecting asks for\n\n- **Your own GitHub App.** GitHub does not let other apps register themselves, so your organization creates a GitHub App and keeps control of it. Give it these permissions: Issues (read and write), Contents (read) and Metadata (read). Set the callback URL to `https://app.agorch.ai/connection-oauth/callback`, then install the app on the repositories your agents may use.\n- **The app's client ID and client secret,** entered once in the Agorch connection. Agorch stores them; they never appear in a package or in this repository.\n- **One sign-in.** The person who connects authorizes the app. The connection then belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `repo` | Read and write issues and read code in your repositories |\n\nA GitHub App ignores OAuth scopes: what the app may do is set by its own permissions above. The `repo` scope only matters if you connect with a classic OAuth App instead.\n\n## Examples\n\n- \"Look for an open issue about the checkout timeout before you open a new one.\"\n- \"Read `CODEOWNERS` in `acme/web` and tell me who owns `src/payments/`.\"\n- \"List the last ten commits in `acme/web`.\"\n\n## Data sent to GitHub\n\nRepository names, issue titles and bodies, and file paths.\n\n## Good to know\n\n- Opening or updating an issue changes data. Agorch never retries it on its own, and the starters ask a person to approve each call.\n- Only the four tools above are allowed through. Everything else the GitHub MCP server offers stays blocked.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"repo":"Read and write issues and read code in your repositories"},"source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/github","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"757fd9b1390251ed6ccf52beb6e2d12cc5898019"}},"version":"0.1.3"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.3","source_kind":"aicl","source_ref":"ao/github"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"get_file_contents","kind":"tool"},{"component_id":"github_search_issues","kind":"tool"},{"component_id":"issue_write","kind":"tool"},{"component_id":"list_commits","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"github_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only","mutating"],"tier":"R1"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}