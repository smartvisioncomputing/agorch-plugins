id":"get_board_items_page","input_schema":{"x-ao-input-schema":"discovered"}}],"kind":"integration_bundle","maintainers":["publisher:ao"],"name":"monday / monday_mcp","namespace":"ao","owner":"publisher:ao","package_id":"monday-mcp","presentation":{"license":"Apache-2.0","readme":"# monday.com\n\nConnect your Agorch agents to monday.com through monday.com's official MCP server (`https://mcp.monday.com/mcp`). Agents can read boards, their columns and groups, and the items on them. This connector is read-only.\n\n## What your agents can do\n\n| Tool | What it does | Changes data |\n|---|---|---|\n| Read a board | Reads a board's details, columns, groups and views. | No |\n| List board items | Lists the items of a board, page by page, with optional filters. | No |\n\n## What connecting asks for\n\n- **One click and one sign-in.** Agorch already has a monday.com app, so there is nothing to create. Click Connect and authorize your monday.com account.\n- The connection belongs to your Agorch organization, and every agent in the organization uses it.\n\n### Permissions\n\n| Scope | In plain words |\n|---|---|\n| `boards:read` | Read your boards, their columns and items |\n\n## Examples\n\n- \"List the items in the Q4 Launch board that are still in Working on it.\"\n- \"Which columns does the Hiring board have?\"\n\n## Data sent to monday.com\n\nBoard IDs and item filters.\n\n## Good to know\n\n- Every tool call counts toward your monday.com account's daily API limit.\n- Only the two read tools above are allowed through.\n","release_notes":"Adds the Apache-2.0 license, an English README, English tool names and descriptions, plain-language descriptions of the requested permissions and the source commit this release was built from. Tool behavior, permissions and endpoints are unchanged.","scope_labels":{"boards:read":"Read your boards, their columns and items"},"source":{"commit":"cb55c29b5f2178bc631ac3eceefe8e2fbaa88565","path":"connectors/monday","repository":"https://github.com/smartvisioncomputing/agorch-plugins","tree":"121d0a1bc4d273de70942e90097203610ede23b8"}},"version":"0.1.3"},"policy_refs":[],"provenance":{"authored_by":"publisher:ao","compiler":{"name":"aicl","version":"1.1.0"},"derived_from":[],"origin":"aicl","sources":[{"revision":"0.1.3","source_kind":"aicl","source_ref":"ao/monday"}],"transformations":[{"name":"aicl.plugin-build","version":"1.1.0"}]},"requirements":{"capabilities":[],"connections":[{"allowed_consumers":[{"component_id":"get_board_info","kind":"tool"},{"component_id":"get_board_items_page","kind":"tool"}],"capabilities":["http.request"],"credential_type_ref":{"component_id":"connection","kind":"connection_definition"},"permissions":[],"requirement_id":"monday_mcp"}],"model":[],"secrets":[]},"risk":{"side_effects":["read_only"],"tier":"R0"},"runtime_contract":{"name":"ao-portable-runtime","required_features":["tool_calls","integration.multitool_shared_connection.v1"],"version_constraint":">=1.0.0 <2.0.0"},"schema_version":"1.1.0"}